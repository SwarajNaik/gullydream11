# =============================================================================
# GullyDream11 Environment Configuration (SSOT)
# =============================================================================
# Copy this file to .env and fill in your values.
# Single Source of Truth — frontend/.env.local is auto-generated from this.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — Neon (free tier: 0.5GB, always-on)
# Sign up: https://neon.tech → Create project → Copy connection string
# -----------------------------------------------------------------------------
# Local development (Docker)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5436/gullydream11"
# Production (Neon) — uncomment and fill after creating Neon project
# DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/gullydream11?sslmode=require"

# -----------------------------------------------------------------------------
# Redis — Upstash (free tier: 10k commands/day)
# Sign up: https://upstash.com → Create Redis database → Copy REST URL + Token
# -----------------------------------------------------------------------------
# Local development (Docker)
REDIS_URL="redis://localhost:6380/0"
# Production (Upstash) — uncomment and fill after creating Upstash Redis
# REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379"

# -----------------------------------------------------------------------------
# Backend API
# -----------------------------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT="8000"
# Local
API_BASE_URL="http://localhost:8000"
# Production (Render) — update after deploying
# API_BASE_URL="https://gullydream11-api.onrender.com"
DEBUG="true"

# -----------------------------------------------------------------------------
# Cricket Data API — CricketData.org (free: 100 requests/day)
# Sign up: https://cricketdata.org → Dashboard → Copy API Key
# Provides: live IPL matches, squads, ball-by-ball scores, player stats
# -----------------------------------------------------------------------------
CRICKET_API_KEY="your-api-key-from-cricketdata-org"
CRICKET_API_URL="https://api.cricapi.com/v1"

# -----------------------------------------------------------------------------
# JWT Authentication
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY="CHANGE-ME-generate-a-random-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Admin email(s) — comma-separated. Users registering with these emails get ADMIN role.
ADMIN_EMAILS="your-email@gmail.com"

# -----------------------------------------------------------------------------
# Production Configuration
# -----------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
ENVIRONMENT="development"
# Options: development, staging, production
SENTRY_DSN=""
# Get from https://sentry.io → Create Project → FastAPI
LOG_LEVEL="INFO"
LOG_FORMAT="text"
# Options: text (dev), json (production)

# -----------------------------------------------------------------------------
# Frontend (Next.js) — auto-copied to frontend/.env.local by run-frontend.sh
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="GullyDream11"
# Local
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production — update after deploying
# NEXT_PUBLIC_API_URL="https://gullydream11-api.onrender.com/api"
# NEXT_PUBLIC_APP_URL="https://gullydream11.vercel.app"
